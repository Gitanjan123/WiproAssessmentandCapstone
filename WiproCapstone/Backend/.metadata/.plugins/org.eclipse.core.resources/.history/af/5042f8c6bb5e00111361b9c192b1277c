spring.application.name=api-gateway
server.port=8080

spring.config.import=optional:configserver:http://localhost:8888

# CORS
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedOrigins=*
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedMethods=GET,POST,PUT,DELETE,OPTIONS
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedHeaders=*
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowedCredentials=false

# Auth Service
spring.cloud.gateway.routes[0].id=auth-service
spring.cloud.gateway.routes[0].uri=lb://auth-service
spring.cloud.gateway.routes[0].predicates[0]=Path=/api/auth/**
spring.cloud.gateway.routes[0].filters[0]=StripPrefix=1

# User Service
spring.cloud.gateway.routes[1].id=user-service
spring.cloud.gateway.routes[1].uri=lb://user-service
spring.cloud.gateway.routes[1].predicates[0]=Path=/api/users/**
spring.cloud.gateway.routes[1].filters[0]=StripPrefix=1

# Song Service \u2014 user routes
spring.cloud.gateway.routes[2].id=song-service
spring.cloud.gateway.routes[2].uri=lb://song-service
spring.cloud.gateway.routes[2].predicates[0]=Path=/api/songs/**
spring.cloud.gateway.routes[2].filters[0]=StripPrefix=1

# Song Service \u2014 admin routes
spring.cloud.gateway.routes[3].id=song-service-admin
spring.cloud.gateway.routes[3].uri=lb://song-service
spring.cloud.gateway.routes[3].predicates[0]=Path=/api/admin/songs/**
spring.cloud.gateway.routes[3].filters[0]=StripPrefix=1

# Playlist Service
spring.cloud.gateway.routes[4].id=playlist-service
spring.cloud.gateway.routes[4].uri=lb://playlist-service
spring.cloud.gateway.routes[4].predicates[0]=Path=/api/playlists/**
spring.cloud.gateway.routes[4].filters[0]=StripPrefix=1

# Notification Service
spring.cloud.gateway.routes[5].id=notification-service
spring.cloud.gateway.routes[5].uri=lb://notification-service
spring.cloud.gateway.routes[5].predicates[0]=Path=/api/notifications/**
spring.cloud.gateway.routes[5].filters[0]=StripPrefix=1

# Admin Service \u2014 users
spring.cloud.gateway.routes[6].id=admin-service-users
spring.cloud.gateway.routes[6].uri=lb://user-service
spring.cloud.gateway.routes[6].predicates[0]=Path=/api/admin/users/**
spring.cloud.gateway.routes[6].filters[0]=StripPrefix=1

# Admin Service \u2014 notifications
spring.cloud.gateway.routes[7].id=admin-service-notif
spring.cloud.gateway.routes[7].uri=lb://notification-service
spring.cloud.gateway.routes[7].predicates[0]=Path=/api/admin/notifications/**
spring.cloud.gateway.routes[7].filters[0]=StripPrefix=1

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/